# Database
DATABASE_URL=postgresql+asyncpg://knowledge_user:knowledge_pass@postgres:5432/knowledge_hub

# LLM
MOCK_LLM_URL=http://mock_llm:8001
LLM_API_KEY=mock-key-do-not-use-in-production
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=4

# Job Queue
JOB_QUEUE_SIZE=100
JOB_WORKER_COUNT=4
JOB_MAX_CONCURRENT_LLM_CALLS=2

# RAG
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5

# Logging
LOG_LEVEL=INFO
